# Public site config. Copy to .env.local and fill in before launch.
# Every value here is safe to expose — they all ship to the browser.

# WhatsApp / phone: full international format, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP=919000000000
# Display phone, human formatted
NEXT_PUBLIC_PHONE_DISPLAY=+91 90000 00000

# Canonical origin, no trailing slash
NEXT_PUBLIC_SITE_URL=https://growthlearners.in

# Google Tag Manager container (loads GA4 + Meta Pixel). Leave blank to disable.
NEXT_PUBLIC_GTM_ID=

# Server-only. Where callback-form leads are POSTed as JSON — a Zapier/Make
# hook, an n8n flow, a Google Apps Script, or the CRM's inbound endpoint.
# Without this the callback form refuses submissions rather than dropping them.
CALLBACK_WEBHOOK_URL=
